    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
